From 02e2ef3dd1aeeede65bea107c43da66176aa62eb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 17 Sep 2026 06:33:03 +0000
Subject: [PATCH] Rebuild About "Our approach" section around the real company
 values

Replaces the generic Precision/Collaboration/Continuity cards with
V-Chip's actual value framework from leadership's Innovate/Integrate/
Accelerate material, plus icon tiles matching the site's existing
icon language (rounded-square, blue-light bg, fills solid on hover).

Adapted the surrounding copy rather than using it verbatim: the
source material describes V-Chip as building its own "SoC and FPGA
solutions," which conflicts with the IC design *services* positioning
used everywhere else on the site (architecture/IP/verification/
analog/physical design engagements, not V-Chip's own chip products).
Kept the three value words and the "smarter, faster, more efficient
systems" outcome language, but wrote each card's description to match
what V-Chip actually does. Worth a check with whoever supplied the
original material in case the product angle is intentional.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SjcntVjf5Nr2bdomgFdfPu
---
 about.html | 53 ++++++++++++++++++++++++++++++++++++++++++-----------
 styles.css | 27 +++++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 11 deletions(-)

diff --git a/about.html b/about.html
index f3471c3..8373890 100644
--- a/about.html
+++ b/about.html
@@ -284,30 +284,61 @@
         <div class="container">
           <div class="section-heading">
             <div>
-              <p class="eyebrow">Our approach</p>
-              <h2>Engineering with purpose.</h2>
+              <p class="eyebrow">Our values</p>
+              <h2>Innovate. Integrate. Accelerate.</h2>
             </div>
+            <p>
+              We combine innovation, flexibility, and engineering excellence
+              to help our customers build smarter, faster, and more
+              efficient systems.
+            </p>
           </div>
           <div class="engagement-grid engagement-grid--cards engagement-grid--values">
             <article>
-              <h3>Precision</h3>
+              <span class="value-icon" aria-hidden="true">
+                <svg viewBox="0 0 24 24">
+                  <path
+                    d="M15 14c.2-1 .7-1.7 1.5-2.5C17.7 10.2 18 9 18 7.5a6 6 0 0 0-12 0c0 1.5.3 2.7 1.5 4 .8.8 1.3 1.5 1.5 2.5"
+                  ></path>
+                  <path d="M9 18h6"></path>
+                  <path d="M10 22h4"></path>
+                </svg>
+              </span>
+              <h3>Innovation</h3>
               <p>
-                Ground design decisions in the specification, from architecture
-                through implementation.
+                Apply forward-thinking engineering to solve complex design
+                challenges, so every project benefits from ideas proven
+                across the last one.
               </p>
             </article>
             <article>
-              <h3>Collaboration</h3>
+              <span class="value-icon" aria-hidden="true">
+                <svg viewBox="0 0 24 24">
+                  <circle cx="18" cy="5" r="3"></circle>
+                  <circle cx="6" cy="12" r="3"></circle>
+                  <circle cx="18" cy="19" r="3"></circle>
+                  <line x1="8.6" y1="10.5" x2="15.4" y2="6.5"></line>
+                  <line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line>
+                </svg>
+              </span>
+              <h3>Integration</h3>
               <p>
-                Keep responsibilities, project reviews, and deliverables clear
-                between teams.
+                Bring architecture, IP, verification, custom analog, and
+                physical design together under one connected engagement, so
+                nothing gets lost between teams.
               </p>
             </article>
             <article>
-              <h3>Continuity</h3>
+              <span class="value-icon" aria-hidden="true">
+                <svg viewBox="0 0 24 24">
+                  <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"></path>
+                </svg>
+              </span>
+              <h3>Acceleration</h3>
               <p>
-                Connect design stages so the next team has the context it needs
-                to move forward.
+                Move projects from concept to silicon faster, backed by
+                reusable infrastructure and hands-on ownership at every
+                stage.
               </p>
             </article>
           </div>
diff --git a/styles.css b/styles.css
index b9b1260..4b593e3 100644
--- a/styles.css
+++ b/styles.css
@@ -3273,6 +3273,33 @@ h3 {
 .engagement-grid--values > * {
   background: #fff;
 }
+.value-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 46px;
+  height: 46px;
+  margin-bottom: 18px;
+  border-radius: 12px;
+  background: var(--blue-light);
+  color: var(--blue);
+  transition:
+    background-color var(--motion-smooth),
+    color var(--motion-smooth);
+}
+.value-icon svg {
+  width: 22px;
+  height: 22px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.8;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.engagement-grid--values > *:hover .value-icon {
+  background: var(--blue);
+  color: #fff;
+}
 @media (max-width: 800px) {
   .page-hero-video {
     padding-block: 120px 64px;
-- 
