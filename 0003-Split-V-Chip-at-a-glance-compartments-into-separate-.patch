From 30c694f2c9a5b566d202b839d3ea924e005ebcae Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 17 Sep 2026 09:02:52 +0000
Subject: [PATCH 3/3] Split "V-Chip at a glance" compartments into separate
 cards

Give each of the three stats-panel cells its own border, background,
and shadow with a gap between them, instead of one panel with internal
dividers, so they read as distinct blocks rather than a single
connected card.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SjcntVjf5Nr2bdomgFdfPu
---
 styles.css | 14 +++++---------
 1 file changed, 5 insertions(+), 9 deletions(-)

diff --git a/styles.css b/styles.css
index 6794cad..0fe9a34 100644
--- a/styles.css
+++ b/styles.css
@@ -1978,28 +1978,26 @@ h3 {
   display: grid;
   grid-template-columns: minmax(220px, 0.85fr) minmax(0, 1.15fr);
   grid-template-rows: auto 1fr;
+  gap: 18px;
   min-width: 0;
+}
+.stats-cell {
+  min-width: 0;
+  padding: 30px 34px;
   border: 1px solid #ffffff14;
   border-radius: 14px;
   background:
     radial-gradient(circle at 100% 0, #4c18213d, transparent 45%), #100c11;
   color: white;
   box-shadow: 0 15px 40px #171a3618;
-  overflow: hidden;
-}
-.stats-cell {
-  min-width: 0;
-  padding: 30px 34px;
 }
 .stats-cell--fields {
   grid-row: 1 / 3;
-  border-right: 1px solid #ffffff14;
 }
 .stats-cell--heading {
   display: flex;
   flex-direction: column;
   justify-content: center;
-  border-bottom: 1px solid #ffffff14;
 }
 .stats-cell--heading .eyebrow {
   margin-bottom: 0;
@@ -2658,8 +2656,6 @@ h3 {
   }
   .stats-cell--fields {
     grid-row: auto;
-    border-right: none;
-    border-bottom: 1px solid #ffffff14;
   }
   .welcome-grid .hero-diagram {
     max-width: 560px;
-- 
