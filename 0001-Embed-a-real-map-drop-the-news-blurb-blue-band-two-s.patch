From 9c2458241a68ac579d7b2e4fe87584d5d741f4d2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 14 Sep 2026 10:23:03 +0000
Subject: [PATCH] Embed a real map, drop the news blurb, blue-band two sections

Remove the "Digital News Asia reported..." blurb and its link from
the About page's Penang presence card -- replace the plain "View on
Google Maps" text link with an actual embedded, interactive map
(iframe) of the Udini Square office, no API key required.

Give the About page's "How we work" section and the Careers page's
"Find your discipline" section a full blue background band, with the
existing white cards floating on top for contrast.

Flip the careers card hover treatment: cards are white by default and
switch to a solid blue background (white text, inverted icon) on
hover/focus, replacing the previous red-icon/light-gray hover.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SjcntVjf5Nr2bdomgFdfPu
---
 about.html   | 37 +++++++++----------------------------
 careers.html |  2 +-
 styles.css   | 50 ++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 56 insertions(+), 33 deletions(-)

diff --git a/about.html b/about.html
index 1e4703c..2703224 100644
--- a/about.html
+++ b/about.html
@@ -215,44 +215,25 @@
               purpose-built to bring architecture, IP, verification, analog,
               and physical design capability together under one roof.
             </p>
-            <p>Digital News Asia reported the opening on 6 January 2026.</p>
-            <a
-              class="text-link"
-              href="https://www.digitalnewsasia.com/business/v-chip-established-its-new-ic-design-facility-penang"
-              >Read the announcement
-              <svg
-                class="link-arrow"
-                aria-hidden="true"
-                focusable="false"
-                viewBox="0 0 24 24"
-              >
-                <path d="M7 17 17 7M7 7h10v10"></path></svg
-            ></a>
             <div class="location-note">
               <strong>V-Chip Penang Office</strong>
               <span
                 >Block 2-03-09 &amp; 2-03-10, Level 3, Udini Square, Lebuh
                 Tunku Kudin 3, 11700 Gelugor, Penang.</span
               >
-              <a
-                class="text-link"
-                href="https://maps.app.goo.gl/hf4rNgG2epcYzhmx5"
-                target="_blank"
-                rel="noopener"
-                >View on Google Maps
-                <svg
-                  class="link-arrow"
-                  aria-hidden="true"
-                  focusable="false"
-                  viewBox="0 0 24 24"
-                >
-                  <path d="M7 17 17 7M7 7h10v10"></path></svg
-              ></a>
+              <div class="location-map">
+                <iframe
+                  src="https://www.google.com/maps?q=Block+2-03-09+%26+2-03-10%2C+Level+3%2C+Udini+Square%2C+Lebuh+Tunku+Kudin+3%2C+11700+Gelugor%2C+Penang&output=embed"
+                  loading="lazy"
+                  referrerpolicy="no-referrer-when-downgrade"
+                  title="Map showing the V-Chip Penang office at Udini Square, Gelugor"
+                ></iframe>
+              </div>
             </div>
           </div>
         </div>
       </section>
-      <section class="section section-tint">
+      <section class="section section-band-blue">
         <div class="container">
           <div class="section-heading">
             <div>
diff --git a/careers.html b/careers.html
index 322a2e9..914be67 100644
--- a/careers.html
+++ b/careers.html
@@ -189,7 +189,7 @@
           </div>
         </div>
       </section>
-      <section class="section">
+      <section class="section section-band-blue">
         <div class="container">
           <div class="section-heading">
             <div>
diff --git a/styles.css b/styles.css
index b8ee45b..311dbbe 100644
--- a/styles.css
+++ b/styles.css
@@ -934,11 +934,16 @@ main:focus {
     transform var(--motion-smooth);
 }
 .career-row:hover {
-  background: var(--surface);
-  border-color: #b7c8d6;
+  background: var(--blue);
+  border-color: var(--blue);
   box-shadow: 0 22px 44px -24px #17203630;
   transform: translateY(-6px);
 }
+.career-row:hover .career-title,
+.career-row:hover .career-location,
+.career-row:hover .career-action {
+  color: #fff;
+}
 .career-icon {
   display: inline-flex;
   align-items: center;
@@ -963,12 +968,13 @@ main:focus {
   stroke-linejoin: round;
 }
 .career-row:hover .career-icon {
-  background: linear-gradient(135deg, var(--red), #c73540);
-  color: #fff;
+  background: #fff;
+  color: var(--blue);
 }
 .career-title {
   font-size: 1.125rem;
   font-weight: 600;
+  transition: color var(--motion-fast);
 }
 .career-location {
   display: inline-flex;
@@ -976,6 +982,7 @@ main:focus {
   gap: 6px;
   color: var(--muted);
   font-size: 0.9375rem;
+  transition: color var(--motion-fast);
 }
 .career-location svg {
   width: 14px;
@@ -993,6 +1000,7 @@ main:focus {
   color: var(--blue);
   font-size: 1.0625rem;
   font-weight: 700;
+  transition: color var(--motion-fast);
 }
 .career-note {
   font-size: 0.9375rem;
@@ -2776,3 +2784,37 @@ h3 {
     background: none;
   }
 }
+
+/* Location map embed */
+.location-map {
+  margin-top: 20px;
+  border-radius: 12px;
+  overflow: hidden;
+  border: 1px solid var(--line);
+}
+.location-map iframe {
+  display: block;
+  width: 100%;
+  height: 220px;
+  border: 0;
+}
+
+/* Blue section band (About "How we work", Careers "Find your discipline") */
+.section-band-blue {
+  background: var(--blue);
+}
+.section-band-blue .eyebrow {
+  color: #d8ecff;
+}
+.section-band-blue h2 {
+  color: #fff;
+}
+.section-band-blue .section-heading > p {
+  color: #e3effa;
+}
+.section-band-blue .career-note {
+  color: #d3e6f8;
+}
+.section-band-blue .career-note a {
+  color: #fff;
+}
-- 
